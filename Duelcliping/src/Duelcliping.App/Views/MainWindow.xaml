<Window x:Class="Duelcliping.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Duelcliping.App.Views"
        Title="Moments" Width="1280" Height="820" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="/Assets/moments.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <!-- Soft blue light in the top-left corner over the blurred backdrop -->
        <Rectangle Fill="{DynamicResource BackdropGlowBrush}" IsHitTestVisible="False" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,14,0,16">
                    <Image DockPanel.Dock="Top" Source="/Assets/logo.png" Width="34" Height="34" Margin="0,0,0,26"
                           RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Moments" />

                    <!-- Live recording state -->
                    <Border DockPanel.Dock="Bottom" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource GlassBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" ToolTip="{Binding Dashboard.StateDetail}">
                        <StackPanel VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{Binding Dashboard.StateBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Dashboard.RailStateText}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton Style="{StaticResource RailButton}" Tag="&#xE80F;" Content="Home" IsChecked="{Binding IsDashboard}" />
                        <RadioButton Style="{StaticResource RailButton}" Tag="&#xE8B7;" Content="Clips" IsChecked="{Binding IsLibrary}" />
                        <RadioButton Style="{StaticResource RailButton}" Tag="&#xE8C6;" Content="Editor" IsChecked="{Binding IsEditor}" />
                        <RadioButton Style="{StaticResource RailButton}" Tag="&#xE9D9;" Content="Stats" IsChecked="{Binding IsPerformance}" />
                        <RadioButton Style="{StaticResource RailButton}" Tag="&#xE713;" Content="Settings" IsChecked="{Binding IsSettings}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top bar: search, live status, quick actions, window buttons -->
                <Grid Background="{DynamicResource TopBarBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <!-- Live state, like a game-detection indicator -->
                        <Border CornerRadius="16" Padding="12,7" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                ToolTip="{Binding Dashboard.StateDetail}" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding Dashboard.StateBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Dashboard.TopStatus}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- Hotkey chips: the keys are the way to clip -->
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Border Background="{DynamicResource GlassStrongBrush}" CornerRadius="7" Padding="7,3">
                                <TextBlock Text="{Binding Dashboard.ClipKey}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding Dashboard.ClipKeyLabel}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,18,0" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource GlassStrongBrush}" CornerRadius="7" Padding="7,3">
                                <TextBlock Text="{Binding Dashboard.RecordKey}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding Dashboard.RecordKeyLabel}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" Width="260" VerticalAlignment="Center" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 Padding="38,9,12,9" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13" Margin="14,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock Text="Search clips" Style="{StaticResource SecondaryText}" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchPlaceholderVisible, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                        <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                        <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close to tray" />
                    </StackPanel>
                </Grid>

                <views:DashboardView Grid.Row="1" DataContext="{Binding Dashboard}" Visibility="{Binding DataContext.IsDashboard, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                <views:LibraryView Grid.Row="1" DataContext="{Binding Library}" Visibility="{Binding DataContext.IsLibrary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                <views:EditorView Grid.Row="1" DataContext="{Binding Editor}" Visibility="{Binding DataContext.IsEditor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                <views:PerformanceView Grid.Row="1" DataContext="{Binding Performance}" Visibility="{Binding DataContext.IsPerformance, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                <views:SettingsView Grid.Row="1" DataContext="{Binding Settings}" Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
