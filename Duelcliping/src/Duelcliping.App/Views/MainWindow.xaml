<Window x:Class="Duelcliping.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Duelcliping.App.Views"
        Title="Duelcliping" Width="1240" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Icon="/Assets/duelcliping.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,14,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,28">
                    <Image Source="/Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Duelcliping" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Clip what matters" Style="{StaticResource LabelText}" FontWeight="Normal" />
                    </StackPanel>
                </StackPanel>

                <!-- Live status pill -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource SubtleCard}" Padding="12,10" Background="{DynamicResource GlassBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding Dashboard.StateBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Dashboard.StateTitle}" FontWeight="SemiBold" Margin="8,0,0,0" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{Binding Dashboard.ModeText}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="16,2,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Dashboard" IsChecked="{Binding IsDashboard}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8B7;" Content="Library" IsChecked="{Binding IsLibrary}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8C6;" Content="Cut" IsChecked="{Binding IsEditor}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Performance" IsChecked="{Binding IsPerformance}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" IsChecked="{Binding IsSettings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" />
            </StackPanel>

            <views:DashboardView Grid.Row="1" DataContext="{Binding Dashboard}" Visibility="{Binding DataContext.IsDashboard, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <views:LibraryView Grid.Row="1" DataContext="{Binding Library}" Visibility="{Binding DataContext.IsLibrary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <views:EditorView Grid.Row="1" DataContext="{Binding Editor}" Visibility="{Binding DataContext.IsEditor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <views:PerformanceView Grid.Row="1" DataContext="{Binding Performance}" Visibility="{Binding DataContext.IsPerformance, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            <views:SettingsView Grid.Row="1" DataContext="{Binding Settings}" Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
