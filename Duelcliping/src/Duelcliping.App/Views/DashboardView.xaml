<UserControl x:Class="Duelcliping.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,8,32,32">
            <TextBlock Text="Dashboard" Style="{StaticResource TitleText}" />
            <TextBlock Text="{Binding ShortcutHint}" Style="{StaticResource SecondaryText}" Margin="0,4,0,22" />

            <!-- Status hero -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse Fill="{Binding StateBrush}" Opacity="0.25" />
                                <Ellipse Fill="{Binding StateBrush}" Width="8" Height="8" />
                            </Grid>
                            <TextBlock Text="{Binding StateTitle}" Style="{StaticResource SectionText}" FontSize="20" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StateDetail}" Style="{StaticResource SecondaryText}" Margin="26,6,0,0" MaxWidth="560" HorizontalAlignment="Left" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReplayEnabled}" Margin="26,16,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="Replay buffer" FontWeight="SemiBold" />
                        </CheckBox>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ToggleRecordingCommand}" VerticalAlignment="Top" Padding="18,11">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource RecordingBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding RecordButtonText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Save -->
            <TextBlock Text="SAVE THE LAST" Style="{StaticResource LabelText}" Margin="4,24,0,8" />
            <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" CommandParameter="15" Content="15 s" Width="88" Margin="0,0,8,8" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" CommandParameter="30" Content="30 s" Width="88" Margin="0,0,8,8" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" CommandParameter="60" Content="1 min" Width="88" Margin="0,0,8,8" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" CommandParameter="120" Content="2 min" Width="88" Margin="0,0,8,8" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" CommandParameter="300" Content="5 min" Width="88" Margin="0,0,8,8" />
                <Button Command="{Binding SaveCustomCommand}" Width="88" Margin="0,0,8,8" ToolTip="Custom duration (Settings → Recording)">
                    <TextBlock Text="{Binding CustomSaveLabel}" />
                </Button>
            </WrapPanel>

            <!-- Facts -->
            <UniformGrid Columns="4" Margin="-6,16,-6,0">
                <Border Style="{StaticResource Card}" Margin="6" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="MODE" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding ModeText}" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="RESOLUTION" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding ResolutionText}" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding BitrateText}" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="FRAME RATE" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding FpsText}" Style="{StaticResource ValueText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="ENCODER" Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding EncoderText}" Style="{StaticResource ValueText}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PipelineText}" Style="{StaticResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Performance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Performance" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding PerformanceModeText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" FontSize="12" />
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="CPU" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="GPU" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding GpuText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="MEMORY" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding RamText}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="BUFFER" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding BufferMemoryText}" Style="{StaticResource ValueText}" FontSize="16" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="DROPPED FRAMES" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding DroppedText}" Style="{StaticResource ValueText}" FontSize="16" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Measured for Duelcliping and its encoder process." Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <!-- Storage -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Storage" Style="{StaticResource SectionText}" />
                            <Button Style="{StaticResource GhostButton}" Content="Settings" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Right" Margin="0,-6,-8,0" />
                        </Grid>
                        <TextBlock Text="{Binding StorageText}" Style="{StaticResource ValueText}" Margin="0,14,0,8" />
                        <ProgressBar Value="{Binding StorageFraction, Mode=OneWay}" Maximum="1" />
                        <TextBlock Text="{Binding StorageDetail}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent clips -->
            <Grid Margin="4,26,0,10">
                <TextBlock Text="Recent clips" Style="{StaticResource SectionText}" />
                <Button Style="{StaticResource GhostButton}" Content="Open library" Command="{Binding OpenLibraryCommand}" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock Text="Saved clips will appear here." Style="{StaticResource SecondaryText}" Margin="4,0,0,0"
                       Visibility="{Binding HasClips, Converter={StaticResource InverseBoolToVis}}" />
            <ItemsControl ItemsSource="{Binding RecentClips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,12,12" Padding="0" Command="{Binding DataContext.OpenClipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" ToolTip="Open in the cutter">
                            <StackPanel>
                                <Border CornerRadius="10,10,0,0" Height="128" Background="#FF0B0A0A" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        <Border Background="#B3000000" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="12,10">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryText}" FontSize="11" FontWeight="Normal" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
