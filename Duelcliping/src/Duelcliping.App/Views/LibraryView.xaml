<UserControl x:Class="Duelcliping.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Grid Margin="32,8,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Library" Style="{StaticResource TitleText}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Refresh" />
                <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,20,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="34,7,10,7" />
                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OnlyRecordings}" Margin="0,0,18,0">
                    <TextBlock Text="Recordings only" Style="{StaticResource SecondaryText}" />
                </CheckBox>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="sort" Content="Newest" IsChecked="{Binding SortNewest}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="sort" Content="Oldest" IsChecked="{Binding SortOldest}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="sort" Content="Longest" IsChecked="{Binding SortLongest}" />
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="sort" Content="Shortest" IsChecked="{Binding SortShortest}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding EmptyText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,80,0,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Clips}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="292" Margin="0,0,14,14" Style="{StaticResource Card}" Padding="0" Cursor="Hand"
                                MouseEnter="OnCardEnter" MouseLeave="OnCardLeave" MouseLeftButtonUp="OnCardClick">
                            <StackPanel>
                                <Border CornerRadius="15,15,0,0" Height="164" Background="#FF0B0A0A" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        <MediaElement Source="{Binding PreviewUri}" IsMuted="True" LoadedBehavior="Play" UnloadedBehavior="Close"
                                                      Stretch="UniformToFill" IsHitTestVisible="False"
                                                      Visibility="{Binding PreviewUri, Converter={StaticResource NullToVis}}" />
                                        <Border Background="#B3000000" CornerRadius="6" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="{DynamicResource RecordingBrush}" CornerRadius="6" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="RECORDING" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="&#xE718;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="14"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" ToolTip="Pinned: never deleted automatically" />
                                    </Grid>
                                </Border>
                                <Grid Margin="14,10,8,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource SecondaryText}" FontSize="11" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryText}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8C6;" ToolTip="Cut / watch"
                                                Command="{Binding DataContext.OpenCommand, ElementName=Self}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="More" Click="OnMoreClick" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Watch / cut" Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Play in default player" Command="{Binding PlacementTarget.Tag.PlayExternalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Rename…" Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Pin / unpin" Command="{Binding PlacementTarget.Tag.PinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Export a copy…" Command="{Binding PlacementTarget.Tag.ExportCopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Export as 1080p MP4…" Command="{Binding PlacementTarget.Tag.Export1080Command, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Export as 720p MP4…" Command="{Binding PlacementTarget.Tag.Export720Command, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Show in folder" Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Delete" Foreground="{DynamicResource DangerBrush}" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Tag>
                                <Binding Path="DataContext" ElementName="Self" />
                            </Border.Tag>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
