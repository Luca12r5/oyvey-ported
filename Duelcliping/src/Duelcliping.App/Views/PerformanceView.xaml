<UserControl x:Class="Duelcliping.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Metric" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,12,28,32">
            <TextBlock Text="Performance" Style="{StaticResource TitleText}" />
            <TextBlock Text="Live, measured values for Moments (app + encoder process). Updated every 2 seconds while this window is open."
                       Style="{StaticResource SecondaryText}" Margin="0,4,0,18" />

            <UniformGrid Columns="4" Margin="-6,0">
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="DUELCLIPING CPU" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding AppCpu}" Style="{StaticResource ValueText}" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="DUELCLIPING GPU" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding AppGpu}" Style="{StaticResource ValueText}" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="VIDEO ENCODER ENGINE" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding EncoderEngine}" Style="{StaticResource ValueText}" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding AppRam}" Style="{StaticResource ValueText}" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="SYSTEM CPU" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding SystemCpu}" Style="{StaticResource ValueText}" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="SYSTEM GPU" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding SystemGpu}" Style="{StaticResource ValueText}" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="RECORDING FPS" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding CaptureFps}" Style="{StaticResource ValueText}" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="ENCODER SPEED" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding EncoderSpeed}" Style="{StaticResource ValueText}" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="FRAMES" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding Dropped}" Style="{StaticResource ValueText}" FontSize="14" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="ENCODER BACKLOG" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding Backlog}" Style="{StaticResource ValueText}" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="STREAM / BUFFER" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding Throughput}" Style="{StaticResource ValueText}" FontSize="16" /><TextBlock Text="{Binding BufferMemory}" Style="{StaticResource SecondaryText}" /></StackPanel></Border>
                <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="DISK WRITE" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding DiskWrite}" Style="{StaticResource ValueText}" FontSize="14" TextWrapping="Wrap" /></StackPanel></Border>
            </UniformGrid>
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Margin="4,8,0,0">
                <Run Text="Pipeline:" /> <Run Text="{Binding Pipeline, Mode=OneWay}" /> <Run Text=" · stable for" /> <Run Text="{Binding Uptime, Mode=OneWay}" />
                <Run Text=" · audio" /> <Run Text="{Binding Silence, Mode=OneWay}" />
            </TextBlock>

            <!-- Benchmark -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="Benchmark: recording off vs. on" Style="{StaticResource SectionText}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,6,0,14"
                               Text="Start a game, click Run, and switch to the game within 10 seconds. Moments measures the same scene with recording disabled, then enabled, and shows the real difference." />
                    <TextBlock Text="{Binding PresentMonState}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="phase" Content="2 × 30 s" IsChecked="{Binding Phase30}" />
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="phase" Content="2 × 60 s" IsChecked="{Binding Phase60}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}" Content="Run benchmark" Command="{Binding StartBenchmarkCommand}" Margin="0,0,8,0" />
                        <Button Content="Cancel" Command="{Binding CancelBenchmarkCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Show report" Command="{Binding OpenReportCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding BenchmarkStatus}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />

                    <Grid Margin="0,14,0,0" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="METRIC" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Column="1" Text="RECORDING OFF" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Column="2" Text="RECORDING ON" Style="{StaticResource LabelText}" />
                                            <TextBlock Grid.Column="3" Text="DIFFERENCE" Style="{StaticResource LabelText}" />
                                        </Grid>
                                        <ItemsPresenter />
                                    </StackPanel>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Metric}" Style="{StaticResource TextBase}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Off}" Style="{StaticResource TextBase}" FontFamily="{StaticResource MonoFont}" />
                                            <TextBlock Grid.Column="2" Text="{Binding On}" Style="{StaticResource TextBase}" FontFamily="{StaticResource MonoFont}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Delta}" Style="{StaticResource TextBase}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
