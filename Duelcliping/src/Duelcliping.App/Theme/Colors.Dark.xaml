<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Duelcliping "Deep Glass" Dark palette (translucent navy + electric blue). Referenced via DynamicResource so themes switch live. -->
    <Color x:Key="WindowBackgroundColor">#FF0A1222</Color>
    <Color x:Key="WindowTintColor">#C20A1428</Color>
    <Color x:Key="SidebarColor">#59060C1A</Color>
    <Color x:Key="TopBarColor">#33060C1A</Color>
    <Color x:Key="SurfaceColor">#99101C33</Color>
    <Color x:Key="SurfaceElevatedColor">#E6172744</Color>
    <Color x:Key="SurfaceHoverColor">#66284170</Color>
    <Color x:Key="SurfacePressedColor">#80315089</Color>
    <Color x:Key="GlassColor">#4D1A2B4D</Color>
    <Color x:Key="GlassStrongColor">#80182A4D</Color>
    <Color x:Key="GlassBorderColor">#24FFFFFF</Color>
    <Color x:Key="BorderColor">#FF23365A</Color>
    <Color x:Key="BorderStrongColor">#FF33507F</Color>
    <Color x:Key="TextPrimaryColor">#FFF2F6FF</Color>
    <Color x:Key="TextSecondaryColor">#FFA7B5D4</Color>
    <Color x:Key="TextTertiaryColor">#FF6F7FA3</Color>
    <Color x:Key="AccentColor">#FF3D8BFF</Color>
    <Color x:Key="AccentHoverColor">#FF5C9EFF</Color>
    <Color x:Key="AccentPressedColor">#FF2F72DB</Color>
    <Color x:Key="AccentSoftColor">#333D8BFF</Color>
    <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
    <Color x:Key="AccentSecondColor">#FF22C3EE</Color>
    <Color x:Key="SuccessColor">#FF4ADE9A</Color>
    <Color x:Key="WarningColor">#FFFACC6B</Color>
    <Color x:Key="DangerColor">#FFFF6B7A</Color>
    <Color x:Key="DangerSoftColor">#2EFF6B7A</Color>
    <Color x:Key="RecordingColor">#FFFF4757</Color>
    <Color x:Key="ShadowColor">#FF000000</Color>
    <Color x:Key="ScrimColor">#99000000</Color>
    <Color x:Key="TimelineKeptColor">#FF3D8BFF</Color>
    <Color x:Key="TimelineRemovedColor">#FF1A2540</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowTintBrush" Color="{StaticResource WindowTintColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="TopBarBrush" Color="{StaticResource TopBarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}" />
    <SolidColorBrush x:Key="GlassStrongBrush" Color="{StaticResource GlassStrongColor}" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentSecondBrush" Color="{StaticResource AccentSecondColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="RecordingBrush" Color="{StaticResource RecordingColor}" />
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
    <SolidColorBrush x:Key="TimelineKeptBrush" Color="{StaticResource TimelineKeptColor}" />
    <SolidColorBrush x:Key="TimelineRemovedBrush" Color="{StaticResource TimelineRemovedColor}" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="1" Color="{StaticResource AccentSecondColor}" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="BackdropGlowBrush" Center="0.15,0" GradientOrigin="0.15,0" RadiusX="0.9" RadiusY="0.8">
        <GradientStop Offset="0" Color="#593D8BFF" />
        <GradientStop Offset="1" Color="#003D8BFF" />
    </RadialGradientBrush>
</ResourceDictionary>
