# Mechanical 1.21.11 -> 26.3 renames, applied to the shared sources while merging (build.gradle).
# Format:  <java regex> ==> <replacement>      (optional prefix "if <regex> :: " = only files that contain it)
# Keep these to plain renames; anything with logic belongs in an overlay file under src/main.
\bGuiGraphics\b ==> GuiGraphicsExtractor
\.renderItemDecorations\( ==> .itemDecorations(
\.renderFakeItem\( ==> .fakeItem(
\.renderItem\( ==> .item(
\bctx\.drawString\( ==> ctx.text(
\bctx\.drawCenteredString\( ==> ctx.centeredText(
(Mc\.mc\(\)|Minecraft\.getInstance\(\)|\bmc|\bvar\d+x*|\bclient|\bminecraft)\.screen\b(?!\s*=[^=])(?!\.v\d) ==> $1.gui.screen()
(Mc\.mc\(\)|Minecraft\.getInstance\(\)|\bmc|\bvar\d+x*|\bclient|\bminecraft)\.setScreen\( ==> $1.gui.setScreen(
\.getOverlay\(\) ==> .gui.overlay()
gameRenderer\.getMainCamera\(\) ==> gameRenderer.mainCamera()
\.getMainRenderTarget\(\) ==> .gameRenderer.mainRenderTarget()
ScreenEvents\.afterRender\( ==> ScreenEvents.afterExtract(
\.displayClientMessage\(([^;]*?), true\) ==> .sendOverlayMessage($1)
\.displayClientMessage\(([^;]*?), false\) ==> .sendSystemMessage($1)
if extends Screen :: public void render\(GuiGraphicsExtractor ==> public void extractRenderState(GuiGraphicsExtractor
if extends Screen :: public void renderBackground\(GuiGraphicsExtractor ==> public void extractBackground(GuiGraphicsExtractor
if extends Screen :: super\.render\( ==> super.extractRenderState(
if extends Screen :: super\.renderBackground\( ==> super.extractBackground(
(Mc\.mc\(\)|Minecraft\.getInstance\(\)|\bmc|\bvar\d+x*|\bclient|\bminecraft)\.options\.hideGui\b ==> $1.gui.hud.isHidden()
import net\.minecraft\.Util; ==> import net.minecraft.util.Util;
Mc\.mc\(\)\.renderBuffers\(\)\.bufferSource\(\) ==> null
if ^(?![\s\S]*Graphics2D)[\s\S]*GuiGraphicsExtractor :: \.drawString\( ==> .text(
if ^(?![\s\S]*Graphics2D)[\s\S]*GuiGraphicsExtractor :: \.drawCenteredString\( ==> .centeredText(
RenderTypes\.entityCutoutNoCull\( ==> RenderTypes.entityCutout(
import net\.fabricmc\.fabric\.api\.client\.rendering\.v1\.world\.WorldRenderContext; ==> import net.fabricmc.fabric.api.client.rendering.v1.level.LevelRenderContext;
\bWorldRenderContext\b ==> LevelRenderContext
\bLevelRenderer\.getLightColor\( ==> net.minecraft.util.LightCoordsUtil.getLightCoords(
\.submitEntityRenderState\( ==> .entity(
Util\.getPlatform\(\)\.openUri\( ==> dev.lego.compat.McCompat.openUri(
# Visor port: render classes that moved to renderpearl in 26.3.
if package dev\.visor :: \bcom\.mojang\.blaze3d\.buffers\.(GpuBuffer|GpuBufferSlice)\b ==> com.mojang.renderpearl.api.buffers.$1
if package dev\.visor :: \bcom\.mojang\.blaze3d\.pipeline\.(BlendFunction|RenderPipeline)\b ==> com.mojang.renderpearl.api.pipeline.$1
if package dev\.visor :: \bcom\.mojang\.blaze3d\.shaders\.UniformType\b ==> com.mojang.renderpearl.api.pipeline.UniformType
if package dev\.visor :: \bcom\.mojang\.blaze3d\.systems\.(CommandEncoder|RenderPass)\b ==> com.mojang.renderpearl.api.commands.$1
if package dev\.visor :: \bcom\.mojang\.blaze3d\.systems\.GpuDevice\b ==> com.mojang.renderpearl.api.device.GpuDevice
if package dev\.visor :: \bcom\.mojang\.blaze3d\.textures\.(AddressMode|FilterMode|GpuSampler|GpuTexture|GpuTextureView)\b ==> com.mojang.renderpearl.api.textures.$1
if package dev\.visor :: \bcom\.mojang\.blaze3d\.vertex\.(VertexFormat|VertexFormatElement)\b ==> com.mojang.renderpearl.api.vertex.$1
if package dev\.visor :: net\.fabricmc\.fabric\.api\.client\.keybinding\.v1\.KeyBindingHelper ==> net.fabricmc.fabric.api.client.keymapping.v1.KeyMappingHelper
if package dev\.visor :: \bKeyBindingHelper\.registerKeyBinding\( ==> KeyMappingHelper.registerKeyMapping(
if package dev\.visor :: \bLivingEntityFeatureRendererRegistrationCallback\b ==> LivingEntityRenderLayerRegistrationCallback
# Visor input: GLFW constants come from a 26.3 stand-in; key codes are translated to GLFW at the mixins.
if package dev\.visor :: import org\.lwjgl\.glfw\.GLFW; ==> import dev.visor.compat.GLFW;
if package dev\.visor :: InputConstants\.isKeyDown\(minecraft\.getWindow\(\), key\.get\(\)\) ==> InputConstants.isKeyDown(dev.lego.compat.Keys.toGame(key.get()))
if package dev\.visor :: InputConstants\.Type\.KEYSYM\.getOrCreate\(this\.value\) ==> dev.lego.compat.Keys.key(this.value)
if package dev\.visor :: \bLightTexture\.block\( ==> net.minecraft.util.LightCoordsUtil.block(
if package dev\.visor :: \bLightTexture\.sky\( ==> net.minecraft.util.LightCoordsUtil.sky(
if package dev\.visor :: import net\.minecraft\.client\.renderer\.LightTexture; ==> // LightTexture: net.minecraft.util.LightCoordsUtil on 26.3
if package dev\.visor :: \.mulPose\( ==> .rotate(
if package dev\.visor :: Math\.max\(1, Math\.min\(8, device\.getMaxSupportedAnisotropy\(\)\)\) ==> 1
if package dev\.visor :: minecraft\.getEntityRenderDispatcher\(\)\.getPlayerRenderer\(player\) ==> (AvatarRenderer<AbstractClientPlayer>) (Object) minecraft.getEntityRenderDispatcher().getRenderer(player)
