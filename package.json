{
  "name": "lego-launcher-monorepo",
  "private": true,
  "description": "LEGO Launcher ecosystem: launcher, backend, website and shared catalog. The Fabric client lives in lego-client/ (Gradle).",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "apps/backend",
    "apps/launcher"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "backend": "npm run start -w apps/backend"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9"
  }
}
