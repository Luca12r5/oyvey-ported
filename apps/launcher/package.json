{
  "name": "@lego/launcher",
  "productName": "LEGO Launcher",
  "version": "0.1.0",
  "private": true,
  "description": "LEGO Launcher \u2013 Minecraft launcher for the LEGO client",
  "author": "LEGO Launcher contributors",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "dist:win": "node build.mjs && electron-builder --win --x64 --publish never",
    "dist:dir": "node build.mjs && electron-builder --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@lego/shared": "*",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10"
  },
  "type": "module"
}
