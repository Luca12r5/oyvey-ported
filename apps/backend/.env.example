# LEGO backend configuration. Never commit real secrets.
LEGO_HOST=127.0.0.1
LEGO_PORT=8787
LEGO_DATA_DIR=/var/lib/lego
LEGO_PUBLIC_ORIGIN=https://api.example.com
LEGO_SECURE_COOKIES=1
LEGO_TRUST_PROXY=1
# LEGO_SESSION_SERVER=https://sessionserver.mojang.com
LEGO_MAINTENANCE=0

# Client build the launcher installs (hash required)
LEGO_CLIENT_URL=
LEGO_CLIENT_VERSION=
LEGO_CLIENT_FILENAME=
LEGO_CLIENT_SHA512=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: AI cape designer ("Mit KI erstellen" in the launcher). Server only - never put this key in the launcher.
# Without it the launcher designs capes with its built-in offline generator.
ANTHROPIC_API_KEY=
# Model for AI cape designs (default claude-opus-5-5).
LEGO_CAPE_AI_MODEL=
